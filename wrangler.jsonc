// Cloudflare Workers config — Vite + React + TypeScript single-page app,
// with this worker handling POST /api/notify and the Supabase keep-alive cron.
// `name` is deliberately the same as the previous Worker ("chat") so deploying
// replaces it and the Supabase webhook URL keeps working unchanged.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / NOTIFY_SECRET / VAPID_* are
  // secrets: they stay in .dev.vars locally and are set on the deployed
  // Worker with `wrangler secret put …` (see README).
}
